# Server-only settings. Never prefix these with NEXT_PUBLIC_.
# Compose supplies these automatically; do not expose a backend host port.
BACKEND_API_URL=http://backend:8000
BACKEND_API_KEY=replace-with-a-long-random-value
APP_TIMEZONE=Asia/Kolkata

# Public frontend origin, including scheme. Set your domain here in production.
APP_URL=http://localhost:3000
